        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT e.id::text AS establishment_id, s.avec_token FROM public.establishments e JOIN public.integration_secrets s ON s.establishment_id=e.id WHERE e.active = true AND s.avec_token IS NOT NULL",
        "options": {}
      },
      "id": "estabelecimentos-avec-ativos",
      "name": "Estabelecimentos AVEC ativos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        490,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.avec.beauty/reports/0046",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "page",
              "value": "1"
            },
            {
              "name": "limit",
              "value": "250"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.avec_token }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "estoque-avec-primeira-pagina",
