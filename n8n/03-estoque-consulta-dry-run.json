      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(i=>({json:{status:\"pagina_1_consultada\",totalChaves:Object.keys(i.json||{}).length,hasMore:i.json?.Data?.HasMore??i.json?.HasMore??null,aviso:\"Consulta parcial. Não enviar alertas antes de validar paginação e formato de resposta.\"}}));"
      },
      "id": "validar-estrutura-do-relatório",
